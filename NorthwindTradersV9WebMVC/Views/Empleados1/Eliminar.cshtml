@model NorthwindTradersV9Entities.Empleado

@{
    ViewData["Title"] = "Eliminar empleado";
}

<h1>Eliminar empleado</h1>

<div class="alert alert-danger">
    <strong>¿Está seguro de que desea eliminar este empleado?</strong>
</div>

<div>
    <strong>Id:</strong> @Model.Id
</div>

<div>
    <strong>Nombre:</strong> @Model.Nombre
</div>

<div>
    <strong>Apellido:</strong> @Model.Apellido
</div>

<br />

<form asp-action="EliminarConfirmado" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-sm btn-danger">
        Sí, eliminar
    </button>

    <a asp-action="Index" class="btn btn-sm btn-secondary">
        Cancelar
    </a>

</form>