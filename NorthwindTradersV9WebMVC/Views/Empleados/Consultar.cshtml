@model NorthwindTradersV9WebMVC.Models.Empleados.EmpleadoConsultarViewModel

@{
    ViewData["Title"] = "Consulta de empleado";
}

<h2>Detalles del empleado</h2>

<form method="post" class="form">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @Html.Raw(TempData["Error"])
        </div>
    }

    <div class="row">
        <div class="col-md-12 mb-3">
            @if (Model.Empleado?.Photo != null && Model.Empleado.Photo.Length > 0)
            {
                <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Empleado.Photo)"
                     alt="Foto del empleado"
                     class="img-thumbnail float-start"
                     style="max-width:150px; max-height:150px;" />
            }        
        </div>
    </div>

    <div class="row">
        <div class="col-md-2 mb-3">
            <label asp-for="Empleado.EmployeeID" class="form-label small">ID</label>
            <input asp-for="Empleado.EmployeeID" class="form-control form-control-sm" readonly />
        </div>

        <div class="col-md-5 mb-3">
            <label asp-for="Empleado.FirstName" class="form-label small">Nombres</label>
            <input asp-for="Empleado.FirstName" class="form-control form-control-sm" readonly />
        </div>

        <div class="col-md-5 mb-3">
            <label asp-for="Empleado.LastName" class="form-label small">Apellidos</label>
            <input asp-for="Empleado.LastName" class="form-control form-control-sm" readonly />
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Empleado.Title" class="form-label small">Título</label>
            <input asp-for="Empleado.Title" class="form-control form-control-sm" readonly />
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="Empleado.TitleOfCourtesy" class="form-label small">
                Título de cortesía
            </label>
            <input asp-for="Empleado.TitleOfCourtesy" class="form-control form-control-sm" readonly />
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 mb-3">
            <label asp-for="Empleado.Address" class="form-label small">Dirección</label>
            <input asp-for="Empleado.Address" class="form-control form-control-sm" readonly />
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Empleado.City" class="form-label small">Ciudad</label>
            <input asp-for="Empleado.City" class="form-control form-control-sm" readonly />
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="Empleado.Region" class="form-label small">Región</label>
            <input asp-for="Empleado.Region" class="form-control form-control-sm" readonly />
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="Empleado.PostalCode" class="form-label small">
                Código postal
            </label>
            <input asp-for="Empleado.PostalCode" class="form-control form-control-sm" readonly />
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Empleado.Country" class="form-label small">País</label>
            <input asp-for="Empleado.Country" class="form-control form-control-sm" readonly />
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="Empleado.HomePhone" class="form-label small">Teléfono</label>
            <input asp-for="Empleado.HomePhone" class="form-control form-control-sm" readonly />
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="Empleado.Extension" class="form-label small">Extensión</label>
            <input asp-for="Empleado.Extension" class="form-control form-control-sm" readonly />
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Empleado.BirthDate" class="form-label small">
                Fecha de nacimiento
            </label>

            <input class="form-control form-control-sm"
                   value="@Model.Empleado?.BirthDate?.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))"
                   readonly />
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="Empleado.HireDate" class="form-label small">
                Fecha de contratación
            </label>

            <input class="form-control form-control-sm"
                   value="@Model.Empleado?.HireDate?.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))"
                   readonly />
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label small">Reporta a</label>

            @if (Model.Empleado?.ReportsTo != null)
            {
                <a asp-controller="Empleados"
                   asp-action="Consultar"
                   asp-route-id="@Model.Empleado.ReportsTo"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   class="form-control form-control-sm">
                    @Model.Empleado.ReportsToName
                </a>
            }
            else
            {
                <input class="form-control form-control-sm" value="N/A" readonly />
            }
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 mb-3">
            <label asp-for="Empleado.Notes" class="form-label small">Notas</label>
            <textarea asp-for="Empleado.Notes"
                      class="form-control form-control-sm"
                      rows="5"
                      readonly
                      style="resize:none; overflow-y:auto; max-height:200px;"></textarea>
        </div>
    </div>

    <a href="@(Model.ReturnUrl ?? Url.Action("Index", "Empleados"))"
       class="btn btn-sm btn-success me-1 navigation-btn"
       title="Volver">

        <i class="bi bi-check-circle"></i>
        <span class="d-none d-md-inline"> Volver</span>

    </a>

    @if (TempData["Error"] != null)
    {
        <a class="btn btn-sm btn-primary me-1 disabled"
           title="Imprimir">

            <i class="bi bi-printer"></i>
            <span class="d-none d-md-inline"> Imprimir</span>

        </a>
    }
    else
    {
        <a href="javascript:void(0)"
           onclick="disableAndOpen(this, '@Url.Action("RptEmpleado", "Empleados", new { id = Model.Empleado?.EmployeeID })')"
           class="btn btn-sm btn-primary me-1"
           title="Imprimir">

            <i class="bi bi-printer"></i>
            <span class="d-none d-md-inline"> Imprimir</span>

        </a>
    }

</form>

@section Scripts {

    <script src="~/js/navigation-actions.js"></script>

    <script>
        $(function () {
            configurarNavegacion();
        });
    </script>

}