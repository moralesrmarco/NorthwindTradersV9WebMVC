@{
    ViewData["Title"] = "Reporte de empleados";
}

<h2>@ViewData["Title"]</h2>

<div class="mb-3">

    <a asp-controller="Empleados"
       asp-action="RptEmpleadosExcel"
       class="btn btn-sm btn-success"
        title="Exportar a Excel">
        <i class="bi bi-file-earmark-excel"></i> 
        <span class="d-none d-md-inline"> Excel</span>
    </a>

    <a asp-controller="Empleados"
       asp-action="RptEmpleadosWord"
       class="btn btn-sm btn-primary"
        title="Exportar a Word">
        <i class="bi bi-file-earmark-word"></i>
        <span class="d-none d-md-inline"> Word</span>
    </a>

</div>

<iframe src="@Url.Action("RptEmpleadosPdf", "Empleados")"
        width="100%"
        height="700"
        style="border:1px solid #ccc;">
</iframe>