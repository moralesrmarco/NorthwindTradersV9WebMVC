@model NorthwindTradersV9WebMVC.Models.Clientes.ClienteConsultarViewModel
@{
    ViewData["Title"] = "Consulta de cliente";
}
<h2>Detalles del cliente</h2>
<form method="post" class="form">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @Html.Raw(TempData["Error"])
        </div>
    }
    <div class="row">
        <div class="col-md-2 mb-3">
            <label asp-for="Cliente.CustomerId" class="form-label small">ID</label>
            <input asp-for="Cliente.CustomerId" class="form-control form-control-sm" readonly />
        </div>
        <div class="col-md-5 mb-3">
            <label asp-for="Cliente.CompanyName" class="form-label small">Nombre de compañía</label>
            <input asp-for="Cliente.CompanyName" class="form-control form-control-sm" readonly />
        </div>
        <div class="col-md-5 mb-3">
            <label asp-for="Cliente.ContactName" class="form-label small">Nombre del contacto</label>
            <input asp-for="Cliente.ContactName" class="form-control form-control-sm" readonly />
        </div>
    </div>
    <div class="row">
        <div class="col-md-3 mb-3">
            <label asp-for="Cliente.ContactTitle" class="form-label small">Título del contacto</label>
            <input asp-for="Cliente.ContactTitle" class="form-control form-control-sm" readonly />
        </div>
        <div class="col-md-9 mb-3">
            <label asp-for="Cliente.Address" class="form-label small">Domicilio</label>
            <input asp-for="Cliente.Address" class="form-control form-control-sm" readonly />
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Cliente.City" class="form-label small">Ciudad</label>
            <input asp-for="Cliente.City" class="form-control form-control-sm" readonly />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Cliente.Region" class="form-label small">Región</label>
            <input asp-for="Cliente.Region" class="form-control form-control-sm" readonly />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Cliente.PostalCode" class="form-label small">Código postal</label>
            <input asp-for="Cliente.PostalCode" class="form-control form-control-sm" readonly />
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Cliente.Country" class="form-label small">País</label>
            <input asp-for="Cliente.Country" class="form-control form-control-sm" readonly />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Cliente.Phone" class="form-label small">Teléfono</label>
            <input asp-for="Cliente.Phone" class="form-control form-control-sm" readonly />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Cliente.Fax" class="form-label small">Fax</label>
            <input asp-for="Cliente.Fax" class="form-control form-control-sm" readonly />
        </div>
    </div>
    <a href="@(Model.ReturnUrl ?? Url.Action("Index", "Clientes"))"
       class="btn btn-sm btn-success me-1 navigation-btn"
       title="Volver">
        <i class="bi bi-check-circle"></i>
        <span class="d-none d-md-inline"> Volver</span>
    </a>
</form>
@section Scripts {
    <script src="~/js/navigation-actions.js"></script>
    <script>
        $(function () {
            configurarNavegacion();
        });
    </script>
}