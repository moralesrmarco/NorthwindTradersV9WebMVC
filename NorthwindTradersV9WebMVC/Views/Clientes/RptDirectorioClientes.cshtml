@{
    ViewData["Title"] = "Reporte directorio de clientes";
}
<h2>@ViewData["Title"]</h2>
<div class="mb-3">
    <a asp-controller="Clientes"
       asp-action="RptDirectorioClientesExcel"
       class="btn btn-sm btn-success"
        title="Exportar a Excel">
        <i class="bi bi-file-earmark-excel"></i> 
        <span class="d-none d-md-inline"> Excel</span>
    </a>
    <a asp-controller="Clientes"
       asp-action="RptDirectorioClientesWord"
       class="btn btn-sm btn-primary"
        title="Exportar a Word">
        <i class="bi bi-file-earmark-word"></i>
        <span class="d-none d-md-inline"> Word</span>
    </a>
</div>
<iframe src="@Url.Action("RptDirectorioClientesPdf", "Clientes")"
        width="100%"
        height="700"
        style="border:1px solid #ccc;">
</iframe>