@model NorthwindTradersV9WebMVC.Models.Administracion.AdministracionUsuariosViewModel

@{
    ViewData["Title"] = "Gestión de usuarios";
}

<h2>@ViewData["Title"]</h2>

<!-- ========================================================= -->
<!-- BÚSQUEDA DE USUARIOS                                     -->
<!-- ========================================================= -->

<ul class="nav nav-tabs mb-0">
    <li class="nav-item small">
        <span class="nav-link active pestaña-buscar">
            <i class="bi bi-search"></i>
            Buscar un usuario
        </span>
    </li>
</ul>

<div class="border border-top-0 p-3 mb-4">
    <form asp-controller="Administracion"
          asp-action="AdministracionUsuarios"
          method="get">

        <div class="row align-items-end">

            <div class="col-md-1">
                <label for="txtIdIni" class="form-label">Id inicial</label>
                <input type="number"
                       class="form-control"
                       id="txtIdIni"
                       name="IdIni"
                       value="@Model.IdIni" />
            </div>

            <div class="col-md-1">
                <label for="txtIdFin" class="form-label">Id final</label>
                <input type="number"
                       class="form-control"
                       id="txtIdFin"
                       name="IdFin"
                       value="@Model.IdFin" />
            </div>

            <div class="col-md-2">
                <label for="Paterno" class="form-label">Apellido paterno</label>
                <input type="text"
                       class="form-control"
                       id="Paterno"
                       name="Paterno"
                       value="@Model.Paterno" />
            </div>

            <div class="col-md-2">
                <label for="Materno" class="form-label">Apellido materno</label>
                <input type="text"
                       class="form-control"
                       id="Materno"
                       name="Materno"
                       value="@Model.Materno" />
            </div>

            <div class="col-md-2">
                <label for="Nombres" class="form-label">Nombres</label>
                <input type="text"
                       class="form-control"
                       id="Nombres"
                       name="Nombres"
                       value="@Model.Nombres" />
            </div>

            <div class="col-md-2">
                <label for="NombreUsuario" class="form-label">Usuario</label>
                <input type="text"
                       class="form-control"
                       id="NombreUsuario"
                       name="NombreUsuario"
                       value="@Model.NombreUsuario" />
            </div>

            <div class="col-md-2">
                <button type="submit"
                        class="btn btn-sm btn-buscar">
                    <i class="bi bi-search"></i>
                    Buscar
                </button>

                <a asp-controller="Administracion"
                   asp-action="AdministracionUsuarios"
                   class="btn btn-sm btn-primary">
                    <i class="bi bi-eraser"></i>
                    Limpiar
                </a>
            </div>

        </div>
    </form>
</div>

<!-- ========================================================= -->
<!-- NUEVO USUARIO                                             -->
<!-- ========================================================= -->
@*
<a asp-controller="Administracion"
   asp-action="AdministracionUsuarioInsertar"
   asp-route-returnUrl="@returnUrl"
   class="btn btn-sm btn-primary mb-3 action-btn"
   title="Nuevo usuario">
    <i class="bi bi-plus-circle"></i>
    <span class="d-none d-md-inline">
        Nuevo usuario
    </span>
</a>
*@

<div class="row">

    <div class="col-md-7">

<!-- ========================================================= -->
<!-- PAGINACIÓN SUPERIOR                                       -->
<!-- ========================================================= -->

<partial name="_Paginacion"
         model="Model.ParametrosPaginacion"
         view-data='new ViewDataDictionary(ViewData)
         {
             ["PageIndex"] = Model.Paginacion.PageIndex,
             ["TotalPages"] = Model.Paginacion.TotalPages,
             ["TotalRegistros"] = Model.Paginacion.TotalRegistros
         }' />

<br />

<!-- ========================================================= -->
<!-- LISTADO DE USUARIOS                                       -->
<!-- ========================================================= -->

<div class="table-responsive">

    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th class="text-center">ID</th>
                <th>Nombre</th>
                <th>Usuario</th>
                <th class="text-center">Estatus</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var usuario in Model.Usuarios)
            {
                <tr class="align-middle">

                    <td class="text-center">
                        @usuario.Id
                    </td>

                    <td>
                        @($"{usuario.Nombres} {usuario.Paterno} {usuario.Materno}".Trim())
                    </td>

                    <td>
                        @usuario.NombreUsuario
                    </td>

                    <td class="text-center">
                        <span class="badge @(usuario.Estatus
                            ? "bg-success"
                            : "bg-danger")">

                            @(usuario.Estatus
                                ? "Activo"
                                : "Inactivo")

                        </span>
                    </td>

                    <td class="text-center text-nowrap">
                        <a asp-controller="Administracion"
                           asp-action="AdministracionUsuarios"
                           asp-route-idUsuario="@usuario.Id"
                           asp-route-pageIndex="@Model.Paginacion.PageIndex"
                           asp-route-IdIni="@Model.IdIni"
                           asp-route-IdFin="@Model.IdFin"
                           asp-route-Paterno="@Model.Paterno"
                           asp-route-Materno="@Model.Materno"
                           asp-route-Nombres="@Model.Nombres"
                           asp-route-NombreUsuario="@Model.NombreUsuario"
                           class="btn btn-sm btn-outline-primary"
                           title="Modificar">
                            <i class="bi bi-pencil"></i>
                        </a>
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>

<br />

<!-- ========================================================= -->
<!-- PAGINACIÓN INFERIOR                                       -->
<!-- ========================================================= -->

<partial name="_Paginacion"
         model="Model.ParametrosPaginacion"
         view-data='new ViewDataDictionary(ViewData)
         {
             ["PageIndex"] = Model.Paginacion.PageIndex,
             ["TotalPages"] = Model.Paginacion.TotalPages,
             ["TotalRegistros"] = Model.Paginacion.TotalRegistros
         }' />

    </div>

    <div class="col-md-5">

    <div class="card">

        <div class="card-header">
            <h4>
                @(Model.Modo == "crear"
                    ? "Registrar usuario"
                    : "Modificar usuario")
            </h4>
        </div>

        <div class="card-body">

            <form id="frmGuardarUsuario"
                  asp-controller="Administracion"
                  asp-action="GuardarUsuario"
                  method="post">

                <input asp-for="UsuarioEdicion.Id" type="hidden" />
                <input asp-for="UsuarioEdicion.RowVersion" type="hidden" />

                <input type="hidden" name="modo" value="@Model.Modo" />
                <input type="hidden" name="pageIndex" value="@Model.Paginacion.PageIndex" />

                <input type="hidden" name="IdIni" value="@Model.IdIni" />
                <input type="hidden" name="IdFin" value="@Model.IdFin" />
                <input type="hidden" name="Paterno" value="@Model.Paterno" />
                <input type="hidden" name="Materno" value="@Model.Materno" />
                <input type="hidden" name="Nombres" value="@Model.Nombres" />
                <input type="hidden" name="NombreUsuario" value="@Model.NombreUsuario" />

                <div asp-validation-summary="ModelOnly"
                    class="text-danger">
                </div>

                @if (Model.Modo == "crear")
                {
                    <div class="row g-2">

                        <div class="col-md-6">
                            <label asp-for="UsuarioEdicion.Paterno" class="form-label">
                                Apellido paterno
                            </label>
                            <input asp-for="UsuarioEdicion.Paterno"
                                   class="form-control" />
                            <span asp-validation-for="UsuarioEdicion.Paterno"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UsuarioEdicion.Materno" class="form-label">
                                Apellido materno
                            </label>
                            <input asp-for="UsuarioEdicion.Materno"
                                   class="form-control" />
                            <span asp-validation-for="UsuarioEdicion.Materno"
                                  class="text-danger"></span>
                        </div>

                    </div>

                    <div class="mb-3">
                        <label asp-for="UsuarioEdicion.Nombres" class="form-label">
                            Nombres
                        </label>
                        <input asp-for="UsuarioEdicion.Nombres"
                               class="form-control" />
                        <span asp-validation-for="UsuarioEdicion.Nombres"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UsuarioEdicion.NombreUsuario" class="form-label">
                            Usuario
                        </label>
                        <input asp-for="UsuarioEdicion.NombreUsuario"
                               class="form-control" />
                        <span asp-validation-for="UsuarioEdicion.NombreUsuario"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UsuarioEdicion.Password" class="form-label">
                            Contraseña
                        </label>
                        <input asp-for="UsuarioEdicion.Password"
                               type="password"
                               class="form-control"
                               placeholder="Proporcione la contraseña"
                               autocomplete="new-password" />
                        <span asp-validation-for="UsuarioEdicion.Password"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UsuarioEdicion.ConfirmarPassword"
                               class="form-label">
                            Confirmar contraseña
                        </label>
                        <input asp-for="UsuarioEdicion.ConfirmarPassword"
                               type="password"
                               class="form-control"
                               placeholder="Proporcione la confirmacion de la contraseña"
                               autocomplete="new-password" />
                        <span asp-validation-for="UsuarioEdicion.ConfirmarPassword"
                              class="text-danger"></span>

                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="UsuarioEdicion.Estatus"
                               class="form-check-input" />
                        <label asp-for="UsuarioEdicion.Estatus"
                               class="form-check-label">
                            Activo
                        </label>
                    </div>
                }
                else
                {
                    <div class="row g-2">

                        <div class="col-md-6">
                            <label asp-for="UsuarioEdicion.Paterno"
                                   class="form-label">
                                Apellido paterno
                            </label>
                            <input asp-for="UsuarioEdicion.Paterno"
                                   class="form-control" />
                            <span asp-validation-for="UsuarioEdicion.Paterno"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UsuarioEdicion.Materno"
                                   class="form-label">
                                Apellido materno
                            </label>
                            <input asp-for="UsuarioEdicion.Materno"
                                   class="form-control" />
                            <span asp-validation-for="UsuarioEdicion.Materno"
                                  class="text-danger"></span>
                        </div>

                    </div>

                    <div class="mb-3">
                        <label asp-for="UsuarioEdicion.Nombres"
                               class="form-label">
                            Nombres
                        </label>
                        <input asp-for="UsuarioEdicion.Nombres"
                               class="form-control" />
                        <span asp-validation-for="UsuarioEdicion.Nombres"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UsuarioEdicion.NombreUsuario"
                               class="form-label">
                            Usuario
                        </label>
                        <input asp-for="UsuarioEdicion.NombreUsuario"
                               class="form-control" />
                        <span asp-validation-for="UsuarioEdicion.NombreUsuario"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UsuarioEdicion.Password"
                               class="form-label">
                            Nueva contraseña (opcional)
                        </label>
                        <input asp-for="UsuarioEdicion.Password"
                               type="password"
                               class="form-control"
                               placeholder="Dejar en blanco para conservar la contraseña actual"
                               autocomplete="new-password" />
                        <span asp-validation-for="UsuarioEdicion.Password"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UsuarioEdicion.ConfirmarPassword"
                               class="form-label">
                            Confirmar contraseña
                        </label>
                        <input asp-for="UsuarioEdicion.ConfirmarPassword"
                               type="password"
                               class="form-control"
                               placeholder="Dejar en blanco para conservar la contraseña actual"
                               autocomplete="new-password" />
                        <span asp-validation-for="UsuarioEdicion.ConfirmarPassword"
                              class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="UsuarioEdicion.Estatus"
                               class="form-check-input" />

                        <label asp-for="UsuarioEdicion.Estatus"
                               class="form-check-label">
                            Activo
                        </label>
                    </div>
                }


                <div class="mt-3">

                    @if (Model.Modo == "crear")
                    {
                        <button type="submit"
                                class="btn btn-sm btn-primary">
                            <i class="bi bi-person-plus"></i>
                            Registrar usuario
                        </button>
                    }
                    else
                    {
                        <button type="submit"
                                class="btn btn-sm btn-primary">
                            <i class="bi bi-save"></i>
                            Guardar cambios
                        </button>
                    }

                    <a asp-controller="Administracion"
                       asp-action="AdministracionUsuarios"
                       asp-route-pageIndex="@Model.Paginacion.PageIndex"
                       asp-route-IdIni="@Model.IdIni"
                       asp-route-IdFin="@Model.IdFin"
                       asp-route-Paterno="@Model.Paterno"
                       asp-route-Materno="@Model.Materno"
                       asp-route-Nombres="@Model.Nombres"
                       asp-route-NombreUsuario="@Model.NombreUsuario"
                       class="btn btn-sm btn-cancelar">
                        <i class="bi bi-x-circle"></i>
                        Cancelar
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/form-buscar.js"></script>

    <script>
        $(document).ready(function () {

            const formulario = $("#frmGuardarUsuario");

            if (!formulario.length) {
                return;
            }

            formulario.on("invalid-form.validate", function () {

                ocultarLoadingOverlay();

            });

        });
    </script>
}