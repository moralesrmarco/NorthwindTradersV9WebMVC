@model NorthwindTradersV9WebMVC.Models.Productos.RptProductosViewModel
@{
    ViewData["Title"] = "Reporte de Productos";
}
<h2 class="mb-4">@ViewData["Title"]</h2>
<ul class="nav nav-tabs" id="tabsReporte">
    <li class="nav-item">
        <button type="button"
                class="nav-link active"
                data-bs-toggle="tab"
                data-bs-target="#todos">
            Imprimir todos los productos
        </button>
    </li>
    <li class="nav-item">
        <button type="button"
                class="nav-link"
                data-bs-toggle="tab"
                data-bs-target="#buscar">
            Buscar un producto
        </button>
    </li>
</ul>
<div class="tab-content border border-top-0 p-3">
    <div class="tab-pane fade show active small" id="todos">
        <form method="post" asp-action="VerPdfRptProductos" asp-controller="Productos" target="visorReporte" class="frmPdf">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PestanaActiva" />
            <div class="row">
                <div class="col-md-4">
                    <label asp-for="Filtro.OrdenadoPor" class="form-label">Ordenar por</label>
                    <select asp-for="Filtro.OrdenadoPor" 
                        class="form-select form-select-sm"
                        asp-items="Model.CamposOrden">
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Filtro.AscDesc" class="form-label">Orden</label>
                    <select asp-for="Filtro.AscDesc" 
                        class="form-select form-select-sm"
                        asp-items="Model.Direcciones">
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" 
                        class="btn btn-sm btn-primary"
                        data-formato="pdf">
                        <i class="bi bi-printer"></i>
                        <span class="d-none d-md-inline"> Imprimir todos</span>
                    </button>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit"
                        asp-controller="Productos"
                        asp-action="ExportarExcelRptProductos"
                        class="btn btn-sm btn-success"
                        formtarget="_self"
                        data-no-overlay="true"
                        data-formato="excel">
                    <i class="bi bi-file-earmark-excel"></i> 
                    <span class="d-none d-md-inline"> Excel</span>
                </button>
                <button type="submit"
                        asp-controller="Productos"
                        asp-action="ExportarWordRptProductos"
                        class="btn btn-sm btn-primary"
                        formtarget="_self"
                        data-no-overlay="true"
                        data-formato="word">
                    <i class="bi bi-file-earmark-word"></i>
                    <span class="d-none d-md-inline"> Word</span>
                </button>
            </div>            
        </form>
    </div>
    <div class="tab-pane fade small" id="buscar">
        <form method="post" asp-action="VerPdfRptProductos" asp-controller="Productos" target="visorReporte" class="frmPdf">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PestanaActiva" />
            <div class="row mb-3">
                <div class="col-md-2">
                    <label asp-for="Filtro.IdIni" class="form-label">ID Inicial</label>
                    <input asp-for="Filtro.IdIni" class="form-control form-control-sm" id="txtIdIni" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Filtro.IdFin" class="form-label">ID Final</label>
                    <input asp-for="Filtro.IdFin" class="form-control form-control-sm" id="txtIdFin" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Filtro.Producto" class="form-label">Producto</label>
                    <input asp-for="Filtro.Producto" class="form-control form-control-sm" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="Filtro.Categoria" class="form-label">Categoría</label>
                    <select asp-for="Filtro.Categoria" 
                        class="form-select form-select-sm"
                        asp-items="Model.Categorias">
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Filtro.Proveedor" class="form-label">Proveedor</label>
                    <select asp-for="Filtro.Proveedor" 
                        class="form-select form-select-sm"
                        asp-items="Model.Proveedores">
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <label asp-for="Filtro.OrdenadoPor" class="form-label">Ordenado por</label>
                    <select asp-for="Filtro.OrdenadoPor" 
                        class="form-select form-select-sm"
                        asp-items="Model.CamposOrden">
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Filtro.AscDesc" class="form-label">Orden</label>
                    <select asp-for="Filtro.AscDesc" 
                        class="form-select form-select-sm"
                        asp-items="Model.Direcciones">
                    </select>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit"
                        class="btn btn-sm btn-primary"
                        data-formato="pdf">
                    <i class="bi bi-printer"></i>
                    <span class="d-none d-md-inline"> Imprimir</span>
                </button>
                <button type="reset"
                        class="btn btn-sm btn-primary">
                    <i class="bi bi-eraser"></i>
                    <span class="d-none d-md-inline"> Limpiar</span>
                </button>
            </div>
            <div class="mt-3">
                <button type="submit"
                        asp-controller="Productos"
                        asp-action="ExportarExcelRptProductos"
                        class="btn btn-sm btn-success"
                        formtarget="_self"
                        data-no-overlay="true"
                        data-formato="excel">
                    <i class="bi bi-file-earmark-excel"></i> 
                    <span class="d-none d-md-inline"> Excel</span>
                </button>
                <button type="submit"
                        asp-controller="Productos"
                        asp-action="ExportarWordRptProductos"
                        class="btn btn-sm btn-primary"
                        formtarget="_self"
                        data-no-overlay="true"
                        data-formato="word">
                    <i class="bi bi-file-earmark-word"></i>
                    <span class="d-none d-md-inline"> Word</span>
                </button>
            </div>
        </form>
    </div>
</div>
<br />
<iframe name="visorReporte" id="visorReporte" class="w-100" style="height: 600px; border: 1px solid #ccc;"></iframe>
@section Scripts {
    <script src="~/js/loading-overlay.js"></script>
    <script src="~/js/form-buscar.js"></script>
    <script>
        document.querySelectorAll('[data-bs-toggle="tab"]').forEach(tab => {
            tab.addEventListener('shown.bs.tab', function() {
                document.querySelectorAll('input[name="PestanaActiva"]')
                    .forEach(h => h.value = this.dataset.bsTarget);
            });
        });
        const pestana = '@Model.PestanaActiva';
        if (pestana) {
            const boton = document.querySelector(
                `[data-bs-target="${pestana}"]`
            );
            if (boton) {
                new bootstrap.Tab(boton).show();
            }
        }
        // Configurar el formulario del reporte ProductosRpt
        function esMovil() {
            return window.innerWidth <= 768;
        }
        document.querySelectorAll(".frmPdf").forEach(function(frm) {
            frm.addEventListener("submit", function(e) {
                const boton = e.submitter;
                if (!boton) return;
                const formato = boton.dataset.formato;
                if (formato === "pdf") {
                    frm.target = esMovil()
                        ? "_blank"
                        : "visorReporte";
                } else {
                    frm.target = "_self";
                }
            });
        });
    </script>
}