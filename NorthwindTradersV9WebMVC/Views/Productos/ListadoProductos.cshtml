@model NorthwindTradersV9WebMVC.Models.Productos.ListadoProductosViewModel
@{
    ViewData["Title"] = "Listado de productos";
}
<h2 class="mb-4">@ViewData["Title"]</h2>
<ul class="nav nav-tabs mb-0">
    <li class="nav-item">
        <button type="button"
                id="btnPestañaBuscar"
                class="nav-link active pestaña-buscar small py-1 px-2"
                data-bs-toggle="collapse"
                data-bs-target="#panelBusqueda"
                aria-expanded="@(Model.BuscarAbierto.ToString().ToLower())"
                aria-controls="panelBusqueda">
            <i class="bi bi-search"></i>
            Buscar producto
        </button>
    </li>
</ul>
<div id="mensajeBusqueda"
     class="border border-top-0 p-3 small text-muted @(Model.BuscarAbierto ? "d-none" : "")">
    Seleccione buscar producto para proporcionar los criterios de búsqueda
</div>
<div id="panelBusqueda" class="collapse border border-top-0 @(Model.BuscarAbierto ? "show" : "")">
    <div class="p-3 small">
        <form asp-controller="Productos"
            asp-action="ListadoProductos"
            method="post"
            id="formBuscar">
            <div class="row mb-3">
                <div class="col-md-2">
                    <label class="form-label">ID inicial</label>
                    <input asp-for="Filtro.IdIni"
                           class="form-control form-control-sm"
                           id="txtIdIni" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">ID final</label>
                    <input asp-for="Filtro.IdFin"
                           class="form-control form-control-sm"
                           id="txtIdFin" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Producto</label>
                    <input asp-for="Filtro.Producto"
                           class="form-control form-control-sm" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">Categoría</label>
                    <select asp-for="Filtro.Categoria"
                            asp-items="Model.Categorias"
                            class="form-select form-select-sm">
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Proveedor</label>
                    <select asp-for="Filtro.Proveedor"
                            asp-items="Model.Proveedores"
                            class="form-select form-select-sm">
                    </select>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">Ordenado por</label>
                    <select asp-for="Filtro.OrdenadoPor"
                            asp-items="Model.CamposOrden"
                            class="form-select form-select-sm">
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Dirección</label>
                    <select asp-for="Filtro.AscDesc"
                            asp-items="Model.Direcciones"
                            class="form-select form-select-sm">
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <button type="submit"
                            id="btnBuscar"
                            class="btn btn-sm btn-buscar"
                            onclick="return disableSearchButton();">
                        <i class="bi bi-search"></i>
                        <span class="d-none d-md-inline"> Buscar</span>
                    </button>
                    <a asp-controller="Productos"
                        asp-action="ListadoProductos"
                       class="btn btn-primary btn-sm navigation-btn"
                        data-show-overlay>
                        <i class="bi bi-eraser"></i>
                        <span class="d-none d-md-inline"> Limpiar</span>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>
<div class="table-responsive mt-3">
    <table class="table table-striped table-bordered">
        <thead class="encabezado-tabla">
            <tr>
                <th>ID</th>
                <th class="text-center">Producto</th>
                <th class="text-center">Cantidad por unidad</th>
                <th class="text-center">Precio</th>
                <th class="text-center">Unidades en inventario</th>
                <th class="text-center">Unidades en pedido</th>
                <th class="text-center">Nivel de reorden</th>
                <th class="text-center">Estatus</th>
                <th class="text-center">Categoría</th>
                <th>Proveedor</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var producto in Model.Productos)
            {
                <tr>
                    <td class="text-center">@producto.ProductID</td>
                    <td>@producto.ProductName</td>
                    <td class="text-center">@producto.QuantityPerUnit</td>
                    <td>@producto.UnitPrice?.ToString("C2")</td>
                    <td class="text-center">@producto.UnitsInStock?.ToString("N0")</td>
                    <td class="text-center">@producto.UnitsOnOrder?.ToString("N0")</td>
                    <td class="text-center">@producto.ReorderLevel?.ToString("N0")</td>
                    @if (producto.Discontinued)
                    {
                        <td class="text-center">
                            <span class="badge bg-danger small">Descontinuado</span>
                        </td>
                    }
                    else
                    {
                        <td class="text-center">
                            <span class="badge bg-success small">Activo</span>
                        </td>
                    }
                    <td class="text-center">@producto.CategoryName</td>
                    <td>@producto.CompanyName</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<br />
 @section Scripts{
    <script src="~/js/loading-overlay.js"></script>
    <script src="~/js/form-buscar.js"></script>
}
