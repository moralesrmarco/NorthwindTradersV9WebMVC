@model NorthwindTradersV9WebMVC.Models.Proveedores.ProveedoresConsultarViewModel
@{
    ViewData["Title"] = "Consultar de proveedor";
}
<h2 class="mb-4">Detalle del proveedor</h2>
<form method="post" class="form">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @Html.Raw(TempData["Error"])
        </div>
    }
    <div class="row">
        <div class="col-md-2 mb-3">
            <label asp-for="Proveedor.SupplierID" class="form-label small">ID</label>
            <input asp-for="Proveedor.SupplierID" class="form-control form-control-sm" readonly />
        </div>
        <div class="col-md-5 mb-3">
            <label asp-for="Proveedor.CompanyName" class="form-label small">Nombre de compañía</label>
            <input asp-for="Proveedor.CompanyName" class="form-control form-control-sm" readonly />
        </div>
        <div class="col-md-5 mb-3">
            <label asp-for="Proveedor.ContactName" class="form-label small">Nombre del contacto</label>
            <input asp-for="Proveedor.ContactName" class="form-control form-control-sm" readonly />
        </div>
    </div>
    <div class="row">
        <div class="col-md-3 mb-3">
            <label asp-for="Proveedor.ContactTitle" class="form-label small">Título del contacto</label>
            <input asp-for="Proveedor.ContactTitle" class="form-control form-control-sm" readonly />
        </div>
        <div class="col-md-9 mb-3">
            <label asp-for="Proveedor.Address" class="form-label small">Domicilio</label>
            <input asp-for="Proveedor.Address" class="form-control form-control-sm" readonly />
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Proveedor.City" class="form-label small">Ciudad</label>
            <input asp-for="Proveedor.City" class="form-control form-control-sm" readonly />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Proveedor.Region" class="form-label small">Región</label>
            <input asp-for="Proveedor.Region" class="form-control form-control-sm" readonly />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Proveedor.PostalCode" class="form-label small">Código postal</label>
            <input asp-for="Proveedor.PostalCode" class="form-control form-control-sm" readonly />
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Proveedor.Country" class="form-label small">País</label>
            <input asp-for="Proveedor.Country" class="form-control form-control-sm" readonly />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Proveedor.Phone" class="form-label small">Teléfono</label>
            <input asp-for="Proveedor.Phone" class="form-control form-control-sm" readonly />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Proveedor.Fax" class="form-label small">Fax</label>
            <input asp-for="Proveedor.Fax" class="form-control form-control-sm" readonly />
        </div>
    </div>
    <a href="@(Model.ReturnUrl ?? Url.Action("Index", "Proveedores"))"
       class="btn btn-sm btn-success me-1 navigation-btn"
       title="Volver">
        <i class="bi bi-check-circle"></i>
        <span class="d-none d-md-inline"> Volver</span>
    </a>
</form>
@section Scripts {
    <script src="~/js/navigation-actions.js"></script>
    <script>
        $(function () {
            configurarNavegacion();
        });
    </script>
}