@model NorthwindTradersV9WebMVC.Models.Ventas.VentasEliminarViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Eliminar venta";
}
<h2 class="mb-4">@ViewData["Title"]</h2>
<form method="post"
    class="form"
    onsubmit="return configurarEliminar('btnEliminar');">
    <div class="alert alert-danger fs-5">
        ¿Está seguro de eliminar la venta con ID: <strong>@Model.Venta?.OrderID</strong> del cliente: <strong>@Model.Venta?.CustomerCompanyName</strong>?
    </div>
    <input type="hidden" asp-for="Venta.RowVersion" />
    <input type="hidden" asp-for="ReturnUrl" />
    @if(TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @Html.Raw(TempData["Error"])
        </div>    
    }
    <ul class="nav nav-tabs" id="tabs">
        <li class="nav-item">
            <button type="button"
                class="nav-link active"
                data-bs-toggle="tab"
                data-bs-target="#consulta">
                <strong>Consulta de la venta</strong>
            </button>
        </li>
        <li class="nav-item">
            <button type="button"
                class="nav-link"
                data-bs-toggle="tab"
                data-bs-target="#detalle">
                <strong>Detalle de la venta</strong>
            </button>
        </li>
    </ul>
    <div class="tab-content border border-top-0 p-3">
        @* Pestaña: Consulta de la venta *@
        <div class="tab-pane fade show active small pt-0" id="consulta">
            <div class="row mb-2">
                <div class="col-md-2">
                    <label asp-for="Venta.OrderID" class="form-label">ID</label>
                    <input asp-for="Venta.OrderID" class="form-control form-control-sm" readonly />
                </div>
                <div class="col-md-5">
                    <label asp-for="Venta.CustomerCompanyName" class="form-label">Cliente</label>
                    <input asp-for="Venta.CustomerCompanyName" class="form-control form-control-sm" readonly />
                </div>
                <div class="col-md-5">
                    <label asp-for="Venta.EmployeeName" class="form-label">Vendedor</label>
                    <input asp-for="Venta.EmployeeName" class="form-control form-control-sm" readonly />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="Venta.OrderDate" class="form-label">Fecha de venta</label>
                    <input class="form-control form-control-sm"
                        value="@Model.Venta?.OrderDate?.ToString("ddd dd 'de' MMM 'de' yyyy HH:mm:ss tt", new CultureInfo("es-MX"))"
                        readonly />
                </div>
                <div class="col-md-4">
                    <label asp-for="Venta.RequiredDate" class="form-label">Fecha requerido</label>
                    <input class="form-control form-control-sm"
                        value="@Model.Venta?.RequiredDate?.ToString("ddd dd 'de' MMM 'de' yyyy HH:mm:ss tt", new CultureInfo("es-MX"))"
                        readonly />
                </div>
                <div class="col-md-4">
                    <label asp-for="Venta.ShippedDate" class="form-label">Fecha de envío</label>
                    <input class="form-control form-control-sm"
                        value="@Model.Venta?.ShippedDate?.ToString("ddd dd 'de' MMM 'de' yyyy HH:mm:ss tt", new CultureInfo("es-MX"))"
                        readonly />
                </div>
            </div>
            <fieldset class="border rounded p-3 pt-0 mb-1">
                <legend class="float-none w-auto px-2 fs-6">
                    <strong>Forma de envío:</strong>
                </legend>
                <div class="row mb-2">
                    <div class="col-md-4">
                        <label asp-for="Venta.ShipperCompanyName" class="form-label">Compañía</label>
                        <input asp-for="Venta.ShipperCompanyName" class="form-control form-control-sm" readonly />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Venta.ShipName" class="form-label">Enviar a</label>
                        <input asp-for="Venta.ShipName" class="form-control form-control-sm" readonly />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Venta.ShipAddress" class="form-label">Domicilio</label>
                        <input asp-for="Venta.ShipAddress" class="form-control form-control-sm" readonly />
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4">
                        <label asp-for="Venta.ShipCity" class="form-label">Ciudad</label>
                        <input asp-for="Venta.ShipCity" class="form-control form-control-sm" readonly />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Venta.ShipRegion" class="form-label">Región</label>
                        <input asp-for="Venta.ShipRegion" class="form-control form-control-sm" readonly />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Venta.ShipPostalCode" class="form-label">Código postal</label>
                        <input asp-for="Venta.ShipPostalCode" class="form-control form-control-sm" readonly />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <label asp-for="Venta.ShipCountry" class="form-label">País</label>
                        <input asp-for="Venta.ShipCountry" class="form-control form-control-sm" readonly />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Venta.Freight" class="form-label">Cargo por envío $</label>
                        <input asp-for="Venta.Freight" class="form-control form-control-sm" readonly />
                    </div>
                </div>
            </fieldset>
        </div>
        @* Pestaña: Detalle de la venta *@
        <div class="tab-pane fade" id="detalle">
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead class="encabezado-tabla">
                        <tr>
                            <th class="text-center">N°</th>
                            <th>Producto</th>
                            <th class="text-center">Precio con impuesto incluido</th>
                            <th class="text-center">Cantidad</th>
                            <th class="text-center">Importe</th>
                            <th class="text-center">Descuento</th>
                            <th class="text-center">Importe del descuento</th>
                            <th class="text-center">Importe con descuento</th>
                            <th class="text-center">Tasa impuesto</th>
                            <th class="text-center">Importe sin impuesto</th>
                            <th class="text-center">Importe del impuesto (Incluido)</th>
                            <th class="text-center"><strong>Subtotal</strong></th>
                        </tr>
                    </thead>

                    @{
                        int numDetalle = Model.Venta?.NumeroProductos ?? 0;
                    }

                    <tbody>
                        @foreach (var detalle in Model.VentaDetalle)
                        {
                            <tr>
                                <td class="text-center">@numDetalle</td>
                                <td>@detalle.ProductName</td>
                                <td class="text-center">@detalle.UnitPrice.ToString("N2")</td>
                                <td class="text-center">@detalle.Quantity.ToString("N0")</td>
                                <td class="text-end">@detalle.SubtotalDelImporteConIVAIncluido.ToString("N2")</td>
                                <td class="text-center">@detalle.Discount.ToString("P2")</td>
                                <td class="text-end">@detalle.SubtotalDelAhorroTotalDespuesDescuento.ToString("N2")</td>
                                <td class="text-end">@detalle.SubtotalDelImporteConIVAConDescuento.ToString("N2")</td>
                                <td class="text-center">@detalle.TasaIVA.ToString("P2")</td>
                                <td class="text-end">@detalle.SubtotalDelImporteSinIVAConDescuento.ToString("N2")</td>
                                <td class="text-end">@detalle.SubtotalIVADespuesDelDescuento.ToString("N2")</td>
                                <td class="text-end"><strong>@detalle.Subtotal.ToString("N2")</strong></td>
                            </tr>

                            numDetalle--;
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @* Totales de la venta *@
        <fieldset class="border rounded p-3 pt-0 mb-1">
            <legend class="float-none w-auto px-2 fs-6">
                <strong>Totales de la venta:</strong>
            </legend>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label class="form-label">Número de productos</label>
                    <input class="form-control form-control-sm text-center" 
                        value="@Model.Venta?.NumeroProductos.ToString("N0")"
                        readonly />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Total de unidades</label>
                    <input class="form-control form-control-sm text-center" 
                        value="@Model.Venta?.TotalUnidades.ToString("N0")"
                        readonly />
                </div>
                <div class="col-md-4">
                    <label asp-for="Venta.SubtotalImporte" class="form-label">Subtotal del importe (Precios con impuesto incluido)</label>
                    <input class="form-control form-control-sm text-end"
                        value="@Model.Venta?.SubtotalImporte.ToString("C2")"
                        readonly />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label class="form-label">Subtotal del importe del descuento</label>
                    <input class="form-control form-control-sm text-end"
                        value="@Model.Venta?.SubtotalImporteDescuento.ToString("C2")"
                        readonly />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Subtotal del importe con descuento</label>
                    <input class="form-control form-control-sm text-end"
                        value="@Model.Venta?.SubtotalImporteConDescuento.ToString("C2")"
                        readonly />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Subtotal del importe sin impuesto</label>
                    <input class="form-control form-control-sm text-end"
                        value="@Model.Venta?.SubtotalImporteSinIVA.ToString("C2")"
                        readonly />
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <label class="form-label">Subtotal del importe del impuesto (Incluido)</label>
                    <input class="form-control form-control-sm text-end"
                        value="@Model.Venta?.SubtotalImporteConIVA.ToString("C2")"
                        readonly />
                </div>
                <div class="col-md-4">
                </div>
                <div class="col-md-4">
                    <label class="form-label"><strong>Total</strong></label>
                    <input class="form-control form-control-sm text-end fw-bold"
                        value="@Model.Venta?.Total.ToString("C2")"
                        readonly />
                </div>
            </div>
        </fieldset>
    </div>
    <br />
    <button type="submit"
        id="btnEliminar"
        class="btn btn-sm btn-danger me-1"
        disabled="@Model.BloquearEliminacion"
        title="Eliminar">
        <i class="bi bi-trash"></i>
        <span class="d-none d-md-inline"> Eliminar</span>
    </button>
    <a href="@(Model.ReturnUrl ?? Url.Action("Index", "Ventas"))"
       class="btn btn-sm btn-cancelar me-1"
       title="Cancelar">
        <i class="bi bi-x-circle"></i>
        <span class="d-none d-md-inline"> Cancelar</span>
    </a>
</form>
@section Scripts {
    <script src="~/js/form-delete.js"></script>
}