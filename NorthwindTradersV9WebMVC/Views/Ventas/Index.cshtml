@model NorthwindTradersV9WebMVC.Models.Ventas.VentasIndexViewModel
@{
    ViewData["Title"] = "Gestión de ventas";
    var returnUrl = Url.Action(
        "Index",
        "Ventas",
        new
        {
            pageIndex = Model.Paginacion.PageIndex,
            IdIni = Model.Filtro.IdIni,
            IdFin = Model.Filtro.IdFin,
            Cliente = Model.Filtro.Cliente,
            FVenta = Model.Filtro.FVenta,
            FVentaIni = Model.Filtro.FVentaIni,
            FVentaFin = Model.Filtro.FVentaFin,
            FVentaNull = Model.Filtro.FVentaNull,
            FRequerido = Model.Filtro.FRequerido,
            FRequeridoIni = Model.Filtro.FRequeridoIni,
            FRequeridoFin = Model.Filtro.FRequeridoFin,
            FRequeridoNull = Model.Filtro.FRequeridoNull,
            FEnvio = Model.Filtro.FEnvio,
            FEnvioIni = Model.Filtro.FEnvioIni,
            FEnvioFin = Model.Filtro.FEnvioFin,
            FEnvioNull = Model.Filtro.FEnvioNull,
            Empleado = Model.Filtro.Empleado,
            CompañiaT = Model.Filtro.CompañiaT,
            DirigidoA = Model.Filtro.DirigidoA,
            BuscarAbierto = Model.ParametrosPaginacion.BuscarAbierto
        });
}
<h2 class="mb-4">@ViewData["Title"]</h2>
<ul class="nav nav-tabs mb-0">
    <li class="nav-item small">
        <button type="button"
                id="btnPestañaBuscar"
                class="nav-link active pestaña-buscar"
                data-bs-toggle="collapse"
                data-bs-target="#panelBusqueda"
                aria-expanded="@(Model.ParametrosPaginacion.BuscarAbierto.ToString().ToLower())"
                aria-controls="panelBusqueda">
            <i class="bi bi-search"></i>
            Buscar venta
        </button>
    </li>
</ul>
<div id="mensajeBusqueda"
     class="border border-top-0 p-3 small text-muted @(Model.ParametrosPaginacion.BuscarAbierto ? "d-none" : "")">
    Seleccione buscar venta para proporcionar los criterios de búsqueda
</div>
<div id="panelBusqueda"
     class="collapse border border-top-0 @(Model.ParametrosPaginacion.BuscarAbierto ? "show" : "")">
    <div class="p-3 small">
        <form asp-controller="Ventas"
            asp-action="Index"
            method="get"
            id="formBuscar"
            onsubmit="return disableSearchButton();">
            <input type="hidden"
                    name="BuscarAbierto"
                    value="true" />
            <div class="row mb-2">
                <div class="col-md-2">
                    <label asp-for="Filtro.IdIni" class="form-label">Id inicial</label>
                    <input type="number"
                            name="Filtro.IdIni"
                            id="txtIdIni"
                            value="@Model.Filtro.IdIni"
                            class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Filtro.IdFin" class="form-label">Id final</label>
                    <input type="number"
                            name="Filtro.IdFin"
                            id="txtIdFin"
                            value="@Model.Filtro.IdFin"
                            class="form-control form-control-sm" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Filtro.Cliente" class="form-label">Cliente</label>
                    <input type="text"
                            name="Filtro.Cliente"
                            value="@Model.Filtro.Cliente"
                            class="form-control form-control-sm" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Filtro.Empleado" class="form-label">Vendedor</label>
                    <input type="text"
                            name="Filtro.Empleado"
                            value="@Model.Filtro.Empleado"
                            class="form-control form-control-sm" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="Filtro.CompañiaT" class="form-label">Compañía de transporte</label>
                    <input type="text"
                            name="Filtro.CompañiaT"
                            value="@Model.Filtro.CompañiaT"
                            class="form-control form-control-sm" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Filtro.DirigidoA" class="form-label">Dirigido a</label>
                    <input type="text"
                            name="Filtro.DirigidoA"
                            value="@Model.Filtro.DirigidoA"
                            class="form-control form-control-sm" />
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="Filtro.FVentaIni" class="form-label">Fecha de venta inicial</label>
                    <input type="date"
                            name="Filtro.FVentaIni"
                            @* el id es necesario para que JavaScript identifique el control *@
                            id="Filtro_FVentaIni" 
                            value="@Model.Filtro.FVentaIni?.ToString("yyyy-MM-dd")"
                            class="form-control form-control-sm" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Filtro.FVentaFin" class="form-label">Fecha de venta final</label>
                    <input type="date"
                            name="Filtro.FVentaFin"
                            @* el id es necesario para que JavaScript identifique el control *@
                            id="Filtro_FVentaFin"
                            value="@Model.Filtro.FVentaFin?.ToString("yyyy-MM-dd")"
                            class="form-control form-control-sm" />
                </div>
                <div class="col-md-4">
                    <div class="mt-4">
                        <label asp-for="Filtro.FVentaNull" class="me-2">
                            Fecha de venta nula
                        </label>
                        <input asp-for="Filtro.FVentaNull"
                               class="form-check-input " 
                               style="transform: scale(1.5);"/>
                    </div>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="Filtro.FRequeridoIni" class="form-label">Fecha de entrega inicial</label>
                    <input type="date"
                            name="Filtro.FRequeridoIni"
                            id="Filtro_FRequeridoIni"
                            value="@Model.Filtro.FRequeridoIni?.ToString("yyyy-MM-dd")"
                            class="form-control form-control-sm" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Filtro.FRequeridoFin" class="form-label">Fecha de entrega final</label>
                    <input type="date"
                            name="Filtro.FRequeridoFin"
                            id="Filtro_FRequeridoFin"
                            value="@Model.Filtro.FRequeridoFin?.ToString("yyyy-MM-dd")"
                            class="form-control form-control-sm" />
                </div>
                <div class="col-md-4">
                    <div class="mt-4">
                        <label asp-for="Filtro.FRequeridoNull" class="me-2">
                            Fecha de entrega nula
                        </label>
                        <input asp-for="Filtro.FRequeridoNull"
                               class="form-check-input " 
                               style="transform: scale(1.5);"/>
                    </div>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-4">
                    <label asp-for="Filtro.FEnvioIni" class="form-label">Fecha de envío inicial</label>
                    <input type="date"
                            name="Filtro.FEnvioIni"
                            id="Filtro_FEnvioIni"
                            value="@Model.Filtro.FEnvioIni?.ToString("yyyy-MM-dd")"
                            class="form-control form-control-sm" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Filtro.FEnvioFin" class="form-label">Fecha de envío final</label>
                    <input type="date"
                            name="Filtro.FEnvioFin"
                            id="Filtro_FEnvioFin"
                            value="@Model.Filtro.FEnvioFin?.ToString("yyyy-MM-dd")"
                            class="form-control form-control-sm" />
                </div>
                <div class="col-md-4">
                    <div class="mt-4">
                        <label asp-for="Filtro.FEnvioNull" class="me-2">
                            Fecha de envío nula
                        </label>
                        <input asp-for="Filtro.FEnvioNull"
                               class="form-check-input " 
                               style="transform: scale(1.5);"/>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12"">
                    <button type="submit"
                            id="btnBuscar"
                            class="btn btn-sm btn-buscar"
                            onclick="return disableSearchButton();">
                        <i class="bi bi-search"></i>
                        <span class="d-none d-md-inline"> Buscar</span>
                    </button>
                    <a asp-controller="Ventas"
                       asp-action="Index"
                       class="btn btn-sm btn-primary navigation-btn">
                        <i class="bi bi-eraser"></i>
                        <span class="d-none d-md-inline"> Limpiar</span>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>
<br />
<a asp-controller="Ventas"
   asp-action="Insertar"
   asp-route-returnUrl="@returnUrl"
   class="btn btn-sm btn-primary mb-3 action-btn"
   title="Nueva venta">
    <i class="bi bi-plus-circle"></i>
    <span class="d-none d-md-inline"> Nueva venta</span>
</a>
<partial name="_Paginacion"
         model="Model.ParametrosPaginacion"
         view-data='new ViewDataDictionary(ViewData)
         {
             ["PageIndex"] = Model.Paginacion.PageIndex,
             ["TotalPages"] = Model.Paginacion.TotalPages,
             ["TotalRegistros"] = Model.Paginacion.TotalRegistros
         }' />
<br />
<div class="table-responsive">
    <table class="table table-striped">
        <thead class="encabezado-tabla">
            <tr>
                <th class="text-center">Id</th>
                <th>Cliente</th>
                <th>Nombre de contacto</th>
                <th class="text-center">Fecha de venta</th>
                <th class="text-center">Fecha de entrega</th>
                <th class="text-center">Fecha de envío</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var venta in Model.Ventas)
            {
                <tr>
                    <td class="text-center">@venta.OrderID</td>
                    <td>@venta.CustomerCompanyName</td>
                    <td>@venta.CustomerContactName</td>
                    <td class="text-end">
                        @if (venta.OrderDate.HasValue)
                        {
                            @Html.Raw(venta.OrderDate.Value
                                .ToString("ddd dd' de 'MMM' de 'yyyy<br/>hh:mm:ss tt"))
                        }
                    </td>
                    <td class="text-end">
                        @if (venta.RequiredDate.HasValue)
                        {
                            @Html.Raw(venta.RequiredDate.Value
                                .ToString("ddd dd' de 'MMM' de 'yyyy<br/>hh:mm:ss tt"))
                        }
                    </td>
                    <td class="text-end">
                        @if (venta.ShippedDate.HasValue)
                        {
                            @Html.Raw(venta.ShippedDate.Value
                                .ToString("ddd dd' de 'MMM' de 'yyyy<br/>hh:mm:ss tt"))
                        }
                    </td>
                    <td class="text-center text-nowrap">
                        <a asp-controller="Ventas" 
                            asp-action="Consultar"
                            asp-route-id="@venta.OrderID" 
                            asp-route-returnUrl="@returnUrl"
                            class="btn btn-sm btn-success me-1 action-btn"
                            title="Consultar">
                            <i class="bi bi-eye"></i>
                            <span class="d-none d-md-inline"> Consultar</span>
                        </a>
                        <a asp-controller="Ventas"
                            asp-action="Editar"
                            asp-route-id="@venta.OrderID"
                            asp-route-returnUrl="@returnUrl"
                            class="btn btn-sm btn-warning me-1 action-btn"
                            title="Editar">
                            <i class="bi bi-pencil"></i>
                            <span class="d-none d-md-inline"> Editar</span>
                        </a>
                        <a asp-controller="Ventas"
                            asp-action="Eliminar"
                            asp-route-id="@venta.OrderID"
                            asp-route-returnUrl="@returnUrl"
                            class="btn btn-sm btn-danger me-1 action-btn"
                            title="Eliminar">
                            <i class="bi bi-trash"></i>
                            <span class="d-none d-md-inline"> Eliminar</span>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<br />
<partial name="_Paginacion"
         model="Model.ParametrosPaginacion"
         view-data='new ViewDataDictionary(ViewData)
         {
             ["PageIndex"] = Model.Paginacion.PageIndex,
             ["TotalPages"] = Model.Paginacion.TotalPages,
             ["TotalRegistros"] = Model.Paginacion.TotalRegistros
         }' />
@section Scripts {
    <script src="~/js/navigation-actions.js"></script>
    <script src="~/js/form-buscar.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            // =====================================================
            // CONFIGURAR UN GRUPO DE FECHAS
            // =====================================================
            function configurarFechas(idFechaIni, idFechaFin, idFechaNull) {

                const fechaIni = document.getElementById(idFechaIni);
                const fechaFin = document.getElementById(idFechaFin);
                const fechaNull = document.getElementById(idFechaNull);

                if (!fechaIni || !fechaFin || !fechaNull) {
                    return;
                }

                // =================================================
                // ACTUALIZAR ESTADO CUANDO SE SELECCIONA
                // "FECHA NULA"
                // =================================================
                function actualizarEstadoFecha() {

                    if (fechaNull.checked) {

                        // Borrar ambas fechas
                        fechaIni.value = "";
                        fechaFin.value = "";

                        // Deshabilitar ambas fechas
                        fechaIni.disabled = true;
                        fechaFin.disabled = true;

                    } else {

                        // Habilitar ambas fechas
                        fechaIni.disabled = false;
                        fechaFin.disabled = false;
                    }
                }


                // =================================================
                // CAMBIO DE FECHA INICIAL
                // =================================================
                fechaIni.addEventListener("change", function() {

                    if (!fechaIni.value) {
                        return;
                    }

                    // Si la fecha final está vacía,
                    // copiar la fecha inicial.
                    if (!fechaFin.value) {
                        fechaFin.value = fechaIni.value;
                        return;
                    }

                    // Si la fecha inicial es mayor que la final,
                    // igualar la final a la inicial.
                    if (fechaIni.value > fechaFin.value) {
                        fechaFin.value = fechaIni.value;
                    }
                });


                // =================================================
                // CAMBIO DE FECHA FINAL
                // =================================================
                fechaFin.addEventListener("change", function() {

                    if (!fechaFin.value) {
                        return;
                    }

                    // Si la fecha inicial está vacía,
                    // copiar la fecha final.
                    if (!fechaIni.value) {
                        fechaIni.value = fechaFin.value;
                        return;
                    }

                    // Si la fecha final es menor que la inicial,
                    // igualar la inicial a la final.
                    if (fechaFin.value < fechaIni.value) {
                        fechaIni.value = fechaFin.value;
                    }
                });


                // =================================================
                // CAMBIO DEL CHECKBOX "FECHA NULA"
                // =================================================
                fechaNull.addEventListener("change", actualizarEstadoFecha);


                // =================================================
                // ESTADO INICIAL AL CARGAR LA PÁGINA
                // =================================================
                actualizarEstadoFecha();
            }


            // =====================================================
            // FECHA DE VENTA
            // =====================================================
            configurarFechas(
                "Filtro_FVentaIni",
                "Filtro_FVentaFin",
                "Filtro_FVentaNull"
            );


            // =====================================================
            // FECHA DE ENTREGA
            // =====================================================
            configurarFechas(
                "Filtro_FRequeridoIni",
                "Filtro_FRequeridoFin",
                "Filtro_FRequeridoNull"
            );


            // =====================================================
            // FECHA DE ENVÍO
            // =====================================================
            configurarFechas(
                "Filtro_FEnvioIni",
                "Filtro_FEnvioFin",
                "Filtro_FEnvioNull"
            );

        });

    </script>
}