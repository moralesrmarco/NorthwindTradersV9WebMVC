@model NorthwindTradersV9WebMVC.Models.Categorias.CategoriasEditarViewModel
@{
    ViewData["Title"] = "Editar categoría";
}
<h2 class="mb-4">@ViewData["Title"]</h2>
<form asp-controller="Categorias"
      asp-action="Editar"
      method="post"
      class="form"
      enctype="multipart/form-data"
      onsubmit="return disableSaveButton();">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @Html.Raw(TempData["Error"])
        </div>        
    }
    <div class="row mb-3">
        <div class="col-md-12">
            <label asp-for="Categoria.CategoryID"
                class="form-label small">
                ID
            </label>
            <input asp-for="Categoria.CategoryID"
                class="form-control form-control-sm" 
                readonly />
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-md-12">
            <label asp-for="Categoria.CategoryName"
                   class="form-label small">
                Nombre
            </label>
            <input asp-for="Categoria.CategoryName"
                   class="form-control form-control-sm" />
            <span asp-validation-for="Categoria.CategoryName"
                  class="text-danger"></span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-md-12">
            <label asp-for="Categoria.Description"
                   class="form-label small">
                Descripción
            </label>
            <textarea asp-for="Categoria.Description"
                      class="form-control form-control-sm"
                      rows="5"
                      style="resize:none; overflow-y:auto; max-height:200px;"></textarea>
            <span asp-validation-for="Categoria.Description"
                  class="text-danger"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 mb-3 d-flex align-items-end">
            <!-- Imagen actual o vista previa -->
            <img id="previewFoto"
                 src="@(!string.IsNullOrEmpty(Model.PictureTemporalBase64)
                     ? $"data:{Model.PictureMime};base64,{Model.PictureTemporalBase64}"
                     : Url.Content("~/images/Categorias.png"))"
                 alt="Imagen de la categoría"
                 class="img-thumbnail"
                 style="max-width:150px; max-height:150px;" />
            <!-- Seleccionar una nueva imagen -->
            <input type="file"
                   asp-for="Picture"
                   id="fileFoto"
                   class="d-none"
                   accept="image/jpeg,image/png,image/gif,image/webp" />
            <span asp-validation-for="Picture"
                  class="text-danger small"></span>
            @if (Model.Categoria?.CategoryID >= 1 &&
                 Model.Categoria?.CategoryID <= 8)
            {
                <button type="button"
                        class="btn btn-secondary ms-2"
                        style="padding:2px 6px; font-size:0.7rem;"
                        disabled>
                    <i class="bi bi-camera"></i>
                    Imagen protegida
                </button>
            }
            else
            {
                <button type="button"
                        class="btn btn-primary ms-2"
                        style="padding:2px 6px; font-size:0.7rem;"
                        onclick="document.getElementById('fileFoto').click();">
                    <i class="bi bi-camera"></i>
                    Cargar imagen...
                </button>
            }
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-md-12">
            <input type="hidden" asp-for="Categoria.RowVersion" />
            <input type="hidden" asp-for="PictureTemporalBase64" />
            <input type="hidden" asp-for="PictureMime" />
            <input type="hidden" asp-for="ReturnUrl" />
            <button type="submit"
                    id="btnGuardar"
                    class="btn btn-sm btn-success me-1"
                    disabled="@Model.BloquearEdicion"
                    title="Guardar">
                <i class="bi bi-save"></i>
                <span class="d-none d-md-inline"> Guardar</span>
            </button>
            <a href="@(Model.ReturnUrl ?? Url.Action("Index", "Categorias"))"
               class="btn btn-sm btn-cancelar me-1"
               title="Cancelar">
                <i class="bi bi-x-circle"></i>
                <span class="d-none d-md-inline"> Cancelar</span>
            </a>
        </div>
    </div>
</form>
@section Scripts {
    <script src="~/js/form-submit.js"></script>
    <script src="~/js/manejo-foto.js"></script>
    <script>
        $(function () {
            configurarSubmitFormulario(null);
            configurarPreviewImagen(
                'fileFoto',
                'previewFoto',
                'PictureTemporalBase64',
                'PictureMime',
                2
            );
        });
    </script>
}
