@model NorthwindTradersV9WebMVC.Models.Categorias.CategoriasEliminarViewModel
@{
    ViewData["Title"] = "Eliminar categoría";
}
<h2 class="mb-4">@ViewData["Title"]</h2>
<div class="alert alert-danger fs-5">
    ¿Está seguro de eliminar la categoría con ID: <strong>@Model.Categoria.CategoryID</strong> - Nombre de categoría: <strong>@Model.Categoria.CategoryName</strong>?
</div>
<form method="post"
    class="form"
    onsubmit="return configurarEliminar('btnEliminar');">
    @if(TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @Html.Raw(TempData["Error"])
        </div>
    }
    <input type="hidden" asp-for="Categoria.RowVersion" />
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="row mb-3">
        <div class="col-md-12">
            <label asp-for="Categoria.CategoryID" class="form-label small">ID</label>
            <input asp-for="Categoria.CategoryID" class="form-control form-control-sm" readonly />
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-md-12">
            <label asp-for="Categoria.CategoryName" class="form-label small">Nombre</label>
            <input asp-for="Categoria.CategoryName" class="form-control form-control-sm" readonly />
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-md-12">
            <label asp-for="Categoria.Description" class="form-label small">Descripción</label>
            <textarea asp-for="Categoria.Description" 
                class="form-control form-control-sm" 
                rows="5"
                readonly
                style="resize:none; overflow-y:auto; max-height:200px;"></textarea>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-md-12">
            @if(Model.Categoria.Picture != null && Model.Categoria.Picture.Length > 0)
            {
                <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Categoria.Picture)"
                    alt="Imagen de la categoría"
                    class="img-thumbnail float-start"
                    style="max-width:250px; max-height:250px;" />
            }
        </div>
    </div>
    <button type="submit"
        id="btnEliminar"
        class="btn btn-sm btn-danger me-1"
        disabled="@Model.BloquearEliminacion"
        title="Eliminar">
        <i class="bi bi-trash"></i>
        <span class="d-none d-md-inline"> Eliminar</span>
    </button>
    <a href="@(Model.ReturnUrl ?? Url.Action("Index", "Categorias"))"
       class="btn btn-sm btn-cancelar me-1"
       title="Cancelar">
        <i class="bi bi-x-circle"></i>
        <span class="d-none d-md-inline"> Cancelar</span>
    </a>
</form>
@section Scripts {
    <script src="~/js/form-delete.js"></script>
}